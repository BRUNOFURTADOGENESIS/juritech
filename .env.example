# Banco de dados (dev local = SQLite, produção = Postgres/Supabase)
DATABASE_URL="file:./dev.db"

# IA
ANTHROPIC_API_KEY=

# Pesquisa de jurisprudência
TAVILY_API_KEY=

# Assinatura eletrônica (Contratação)
ZAPSIGN_API_TOKEN=

# Canal: E-mail (envio via SMTP — Gmail com senha de app, Outlook, SES, etc.)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# Canal: WhatsApp (Z-API — z-api.io, conecta via QR code, sem aprovação da Meta)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_SECRET=

# URL pública do app (usada nos links enviados por mensagem, ex: agendamento)
APP_URL=

# Segredo do endpoint de follow-up de cobrança (chamado por um agendador externo)
CRON_SECRET=

# Agendamento (Google Calendar é opcional/futuro — hoje o agendamento é interno,
# via a tabela SlotAgendamento, sem depender de conta externa)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
